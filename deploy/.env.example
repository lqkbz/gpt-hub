# 复制为 .env 后按需修改
NAPCAT_UID=1000
NAPCAT_GID=1000
# 机器人 QQ 号（首次扫码登录后填写）
NAPCAT_ACCOUNT=
CODEX_VERSION=0.165.0
TZ=Asia/Shanghai
# 固定 NapCat 设备指纹（首次部署后不要再改）
NAPCAT_HOSTNAME=qqbot-napcat
NAPCAT_MAC=02:42:ac:11:00:02
# 快速登录失效时的密码兜底（二选一；MD5 = 密码的 32 位小写 md5）
NAPCAT_QUICK_PASSWORD=
NAPCAT_QUICK_PASSWORD_MD5=
